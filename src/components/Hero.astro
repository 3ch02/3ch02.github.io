---
import { CV, SITE, SOCIALS } from '@/config/site';
import { url } from '@/lib/utils';
import { useI18n } from '@/i18n';
import Icon from './Icon.astro';
import Terminal from './Terminal.astro';

const { locale, t, href } = useI18n(Astro.url);
---

<section class="relative overflow-hidden">
  <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-page relative grid items-center gap-12 pt-16 pb-20 sm:pt-24 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pt-28 lg:pb-28">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 font-mono text-xs text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span class="hidden sm:inline">{t.site.role} ·</span>
        {SITE.school}
      </p>

      <h1 class="mt-6">
        <span class="block font-mono text-5xl font-bold tracking-tight text-fg sm:text-6xl lg:text-7xl">
          3ch<span class="text-accent">0</span>
        </span>
        <span class="mt-3 block text-xl font-medium tracking-tight text-muted sm:text-2xl">{SITE.name}</span>
      </h1>

      <p class="mt-6 text-lg font-medium text-fg sm:text-xl">{t.site.role}</p>
      <p class="mt-1 font-mono text-sm text-accent">{t.site.focus.join(' • ')}</p>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-[1.05rem]">
        {
          locale === 'fr'
            ? "J'étudie la cybersécurité, avec un intérêt marqué pour les systèmes et les réseaux. J'apprends en montant des labs, en cassant des choses en CTF, en analysant ce qui s'est passé, puis en l'écrivant. Ce site rassemble ce travail."
            : 'I study cybersecurity with a strong focus on systems and networks. I learn by building labs, breaking things in CTFs, analysing what happened — and writing it down. This site is where that work lives.'
        }
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={href('/projects')} class="btn-primary">
          {t.hero.viewProjects} <Icon name="arrow" size={16} />
        </a>
        <a href={href('/writeups')} class="btn-ghost">
          <Icon name="file" size={16} /> {t.hero.readWriteups}
        </a>
        {
          CV.available ? (
            <a href={url(CV.href)} class="btn-ghost" download>
              <Icon name="download" size={16} /> {t.hero.downloadCv}
            </a>
          ) : (
            <a href={href('/contact')} class="btn-ghost" title={t.hero.requestCvTitle}>
              <Icon name="download" size={16} /> {t.hero.requestCv}
            </a>
          )
        }
      </div>

      {
        SOCIALS.length > 0 && (
          <ul class="mt-8 flex items-center gap-2">
            {SOCIALS.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="me noopener"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
                  aria-label={s.label}
                  title={s.label}
                >
                  <Icon name={s.icon} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="w-full max-w-md justify-self-center lg:justify-self-end">
      <Terminal />
    </div>
  </div>
</section>
