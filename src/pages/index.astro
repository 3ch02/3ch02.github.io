---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CompetitionCard from '@/components/CompetitionCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import WriteupCard from '@/components/WriteupCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import Icon from '@/components/Icon.astro';
import { getCompetitions, getProjects, getWriteups, writeupsFor } from '@/lib/content';
import { url } from '@/lib/utils';

const [competitions, projects, writeups] = await Promise.all([getCompetitions(), getProjects(), getWriteups()]);
const featuredProjects = projects.filter((p) => p.data.featured);
const otherProjects = projects.filter((p) => !p.data.featured).slice(0, 2);
const latestWriteups = writeups.slice(0, 6);

const approach = [
  { step: '01', title: 'Learn', text: 'Courses at IPNET, documentation, RFCs — understanding how systems and protocols really work.' },
  { step: '02', title: 'Build', text: 'Labs and projects: networks, firewalls, servers, applications. Configuration is where the details show up.' },
  { step: '03', title: 'Break', text: 'CTFs and exercises: web, forensics, crypto, Boot2Root. Finding where assumptions fail.' },
  { step: '04', title: 'Document', text: 'Write-ups and notes. If I cannot explain it clearly, I have not understood it yet.' },
];
---

<Layout>
  <Hero />

  <!-- CTF track record -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow="CTF" title="Competitions" href="/ctf" linkLabel="All competitions" />
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        competitions.slice(0, 4).map((c) => (
          <div class="reveal">
            <CompetitionCard entry={c} writeupCount={writeupsFor(c, writeups).length} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projects -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow="Projects" title="What I'm building" href="/projects" linkLabel="All projects" />
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {
        featuredProjects.map((p) => (
          <div class:list={['reveal', otherProjects.length > 0 ? 'lg:col-span-2' : 'lg:col-span-3']}>
            <ProjectCard entry={p} highlight />
          </div>
        ))
      }
      {
        otherProjects.map((p) => (
          <div class="reveal">
            <ProjectCard entry={p} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Writeups -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow="Writeups" title="Latest CTF write-ups" href="/writeups" linkLabel="All write-ups" />
    </div>
    {
      latestWriteups.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {latestWriteups.map((w) => (
            <div class="reveal">
              <WriteupCard entry={w} />
            </div>
          ))}
        </div>
      ) : (
        <div class="reveal">
          <EmptyState title="Write-ups in progress" icon="file">
            Solutions from recent competitions are being cleaned up and written. They will appear here — with the commands, scripts
            and reasoning behind each flag.
          </EmptyState>
        </div>
      )
    }
  </section>

  <!-- Approach + skills -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow="Approach" title="How I learn" />
    </div>
    <ol class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        approach.map((a) => (
          <li class="reveal bg-surface p-6">
            <span class="font-mono text-xs text-accent">{a.step}</span>
            <h3 class="mt-3 font-semibold text-fg">{a.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{a.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-16">
      <SectionHeading eyebrow="Skills" title="Areas I work on" href="/about#skills" linkLabel="More about me" />
      <SkillGroups />
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal card relative overflow-hidden px-6 py-10 sm:px-10 sm:py-12">
      <div class="grid-backdrop pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow">Contact</p>
          <h2 class="section-title mt-2">Let's talk security, CTFs or infrastructure.</h2>
          <p class="mt-3 text-muted">A question about a write-up, a project, or an opportunity — feel free to reach out.</p>
        </div>
        <a href={url('/contact')} class="btn-primary shrink-0">Get in touch <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Layout>
