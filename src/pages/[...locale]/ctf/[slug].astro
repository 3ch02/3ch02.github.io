---
import { render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import CompetitionCard from '@/components/CompetitionCard.astro';
import WriteupCard from '@/components/WriteupCard.astro';
import { bodyOf, currentResult, getCompetitions, getWriteups, writeupsFor } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export async function getStaticPaths() {
  return withLocales((await getCompetitions()).map((entry) => ({ params: { slug: entry.id } })));
}

const { locale, t } = useI18n(Astro.url);
const entry = (await getCompetitions(locale)).find((c) => c.id === Astro.params.slug)!;
const { name, team } = entry.data;
const related = writeupsFor(entry, await getWriteups());
const { stage, pending } = currentResult(entry);
const { Content } = await render(await bodyOf(entry, locale));

const description = stage?.rank
  ? `${t.ctf.place(stage.rank)}${entry.data.stages.length > 1 ? ` (${stage.name.toLowerCase()})` : ''} ${t.ctf.withTeam(team)}.${pending.length ? ` ${pending.map((p) => `${p.name}: ${t.status[p.status].toLowerCase()}`).join(', ')}.` : ''}`
  : t.ctf.teamOnly(team);
---

<ArticleLayout title={name} description={description} back={{ href: '/ctf', label: t.ctf.back }}>
  <span slot="meta-top" class="eyebrow">CTF</span>

  <div slot="meta" class="mt-8 max-w-xl">
    <CompetitionCard entry={entry} writeupCount={related.length} detailed link={false} />
  </div>

  <Content />

  <section slot="after" class="mt-14">
    <h2 class="mb-5 text-xl font-semibold text-fg">{t.ctf.writeupsTitle}</h2>
    {
      related.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2">{related.map((w) => <WriteupCard entry={w} />)}</div>
      ) : (
        <p class="text-sm text-muted">{t.ctf.noWriteups}</p>
      )
    }
  </section>
</ArticleLayout>
