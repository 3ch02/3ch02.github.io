---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WriteupExplorer from '@/components/WriteupExplorer.astro';
import WriteupCard from '@/components/WriteupCard.astro';
import Tag from '@/components/Tag.astro';
import Icon from '@/components/Icon.astro';
import { countTags, getWriteups } from '@/lib/content';
import { url } from '@/lib/utils';
import { useI18n, withLocales } from '@/i18n';

export const getStaticPaths = () => withLocales();

const { t, href } = useI18n(Astro.url);

const writeups = await getWriteups();
const featured = writeups.filter((w) => w.data.featured).slice(0, 3);
const tags = countTags(writeups).slice(0, 20);
---

<Layout title={t.writeups.title} description={t.writeups.metaDescription}>
  <PageHeader
    eyebrow="writeups"
    title={t.writeups.title}
    description={t.writeups.description}
  >
    <a href={url('/rss.xml')} class="mt-5 inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-accent">
      <Icon name="rss" size={14} /> {t.writeups.rss}
    </a>
  </PageHeader>

  {
    featured.length > 0 && (
      <section class="container-page mb-14">
        <p class="eyebrow mb-4">{t.writeups.featured}</p>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((w) => <WriteupCard entry={w} />)}
        </div>
      </section>
    )
  }

  <section class="container-page">
    <WriteupExplorer entries={writeups} all={writeups} />
  </section>

  {
    tags.length > 0 && (
      <section class="container-page mt-16">
        <div class="mb-4 flex items-center justify-between">
          <p class="eyebrow">{t.writeups.tags}</p>
          <a href={href('/tags')} class="text-sm text-muted hover:text-fg">{t.writeups.allTags}</a>
        </div>
        <div class="flex flex-wrap gap-2">{tags.map(([tag, n]) => <Tag tag={tag} count={n} />)}</div>
      </section>
    )
  }
</Layout>
