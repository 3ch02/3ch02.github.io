---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WriteupExplorer from '@/components/WriteupExplorer.astro';
import { getSources, getWriteups, sourceFamily } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export async function getStaticPaths() {
  const all = await getWriteups();
  return withLocales(getSources(all).map((source) => ({ params: { source: source.slug }, props: { source } })));
}

const { source } = Astro.props;
const all = await getWriteups();
const entries = all.filter((w) => sourceFamily(w.data.ctf) === source.name);
const { t } = useI18n(Astro.url);
const description = t.writeups.sourceDescription(entries.length, source.name, source.kind === 'competition');
---

<Layout title={t.writeups.categoryTitle(source.name)} description={description}>
  <PageHeader
    eyebrow={`writeups/source/${source.slug}`}
    title={source.name}
    description={description}
  />
  <section class="container-page">
    <WriteupExplorer entries={entries} all={all} activeSource={source.name} />
  </section>
</Layout>
