---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getProjects } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export const getStaticPaths = () => withLocales();

const { locale, t } = useI18n(Astro.url);

const projects = await getProjects(locale);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---

<Layout title={t.projects.title} description={t.projects.metaDescription}>
  <PageHeader
    eyebrow="projects"
    title={t.projects.title}
    description={t.projects.description}
  />
  <section class="container-page space-y-5">
    {projects.length === 0 && <EmptyState title={t.projects.empty} icon="folder" />}
    {featured.map((p) => <div class="reveal"><ProjectCard entry={p} highlight /></div>)}
    {
      others.length > 0 && (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((p) => <div class="reveal"><ProjectCard entry={p} /></div>)}
        </div>
      )
    }
  </section>
</Layout>
