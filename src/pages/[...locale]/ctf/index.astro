---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CompetitionCard from '@/components/CompetitionCard.astro';
import AchievementCard from '@/components/AchievementCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WriteupCard from '@/components/WriteupCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { currentResult, getAchievements, getCompetitions, getWriteups, writeupsFor } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export const getStaticPaths = () => withLocales();

const { locale, t, href } = useI18n(Astro.url);

const [competitions, writeups, achievements] = await Promise.all([getCompetitions(locale), getWriteups(), getAchievements(locale)]);

const podiums = competitions.filter((c) => (currentResult(c).stage?.rank ?? 99) <= 3).length;
// Write-ups actually tied to a competition (vs. training-platform write-ups shown on /writeups/)
const byCompetition = new Map(competitions.map((c) => [c.id, writeupsFor(c, writeups)]));
const linkedWriteups = [...byCompetition.values()].flat();
const categories = new Set(linkedWriteups.map((w) => w.data.category));
const stats = [
  { value: competitions.length, label: t.ctf.stats.competitions },
  { value: podiums, label: t.ctf.stats.podiums },
  { value: linkedWriteups.length, label: t.ctf.stats.writeups },
  { value: categories.size, label: t.ctf.stats.categories },
];
---

<Layout title={t.ctf.title} description={t.ctf.metaDescription}>
  <PageHeader
    eyebrow="ctf"
    title={t.ctf.heading}
    description={t.ctf.description}
  >
    <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="bg-surface px-5 py-4">
            <dt class="font-mono text-[0.7rem] text-subtle uppercase">{s.label}</dt>
            <dd class="mt-1 font-mono text-2xl font-semibold text-fg">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </PageHeader>

  {
    achievements.length > 0 && (
      <section class="container-page mb-16">
        <SectionHeading eyebrow={t.achievements.eyebrow} title={t.achievements.title} />
        <div class="grid gap-5 lg:grid-cols-2">{achievements.map((a) => <div class="reveal"><AchievementCard entry={a} /></div>)}</div>
      </section>
    )
  }

  <section class="container-page">
    <SectionHeading eyebrow={t.ctf.title} title={t.ctf.allCompetitions} />
    <div class="grid gap-5 md:grid-cols-2">
      {competitions.map((c) => <div class="reveal"><CompetitionCard entry={c} writeupCount={writeupsFor(c, writeups).length} detailed /></div>)}
    </div>
  </section>

  <section class="container-page mt-20">
    <SectionHeading eyebrow={t.home.writeupsEyebrow} title={t.ctf.byCompetition} href="/writeups" linkLabel={t.home.writeupsLink} />
    {
      linkedWriteups.length === 0 ? (
        <EmptyState title={t.ctf.noneTitle} icon="file">{t.ctf.noneText}</EmptyState>
      ) : (
        <div class="space-y-12">
          {competitions
            .filter((c) => (byCompetition.get(c.id)?.length ?? 0) > 0)
            .map((c) => (
              <div>
                <h3 class="mb-4 font-mono text-sm text-muted">
                  <a href={href(`/ctf/${c.id}`)} class="hover:text-fg"><span class="text-accent">#</span> {c.data.name}</a>
                </h3>
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {byCompetition.get(c.id)!.map((w) => <WriteupCard entry={w} compact />)}
                </div>
              </div>
            ))}
        </div>
      )
    }
  </section>
</Layout>
