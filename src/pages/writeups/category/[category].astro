---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WriteupExplorer from '@/components/WriteupExplorer.astro';
import { WRITEUP_CATEGORIES } from '@/content.config';
import { categorySlug, getWriteups } from '@/lib/content';

export function getStaticPaths() {
  return WRITEUP_CATEGORIES.map((category) => ({ params: { category: categorySlug(category) }, props: { category } }));
}

const { category } = Astro.props;
const all = await getWriteups();
const entries = all.filter((w) => w.data.category === category);
---

<Layout title={`${category} writeups`} description={`CTF write-ups in the ${category} category by 3ch0.`}>
  <PageHeader eyebrow={`writeups/${categorySlug(category)}`} title={category} description={`CTF write-ups in the ${category} category.`} />
  <section class="container-page">
    <WriteupExplorer entries={entries} all={all} active={category} />
  </section>
</Layout>
