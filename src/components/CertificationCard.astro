---
import type { CollectionEntry } from 'astro:content';
import { formatMonth, isoDate } from '@/lib/utils';
import { useI18n } from '@/i18n';
import StatusBadge from './StatusBadge.astro';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'certifications'>;
}
const { entry } = Astro.props;
const { title, issuer, kind, status, date, expires, credentialUrl, credentialId, skills, draft } = entry.data;
const { locale, t } = useI18n(Astro.url);
const expired = expires !== undefined && expires.valueOf() < Date.now();
---

<article class="card flex h-full flex-col p-5">
  <div class="flex items-start justify-between gap-3">
    <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line bg-surface-2 text-accent">
      <Icon name={kind === 'certification' ? 'award' : 'book'} size={17} />
    </span>
    <div class="flex items-center gap-2">
      {draft && <span class="rounded bg-warn/15 px-1.5 font-mono text-[0.7rem] text-warn">{t.common.draft}</span>}
      {expired ? <StatusBadge status="archived" label={t.status.expired} /> : <StatusBadge status={status} />}
    </div>
  </div>
  <h3 class="mt-4 font-semibold text-fg">{title}</h3>
  <p class="mt-1 text-sm text-muted">
    {issuer}
    {date && <> · <time datetime={isoDate(date)}>{formatMonth(date, locale)}</time></>}
  </p>
  {
    expires && (
      <p class="mt-1 text-xs text-subtle">
        {expired ? t.status.expired : t.certifications.validUntil} <time datetime={isoDate(expires)}>{formatMonth(expires, locale)}</time>
      </p>
    )
  }
  {credentialId && <p class="mt-1 font-mono text-xs break-all text-subtle">ID: {credentialId}</p>}
  {skills.length > 0 && <div class="mt-4 flex flex-wrap gap-1.5">{skills.map((s) => <span class="chip">{s}</span>)}</div>}
  {
    credentialUrl && (
      <a href={credentialUrl} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm text-accent hover:underline">
        {t.certifications.verify} <Icon name="external" size={14} />
      </a>
    )
  }
</article>
