---
import { useI18n } from '@/i18n';

interface Props {
  tag: string;
  count?: number;
  link?: boolean;
}
const { tag, count, link = true } = Astro.props;
const { href } = useI18n(Astro.url);
const Element = link ? 'a' : 'span';
---

<Element
  href={link ? href(`/tags/${tag}`) : undefined}
  class:list={['chip', link && 'hover:border-line-strong hover:text-fg transition-colors']}
>
  <span class="text-accent-dim">#</span>{tag}
  {count !== undefined && <span class="ml-1.5 text-subtle">{count}</span>}
</Element>
