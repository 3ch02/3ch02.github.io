---
import type { CollectionEntry } from 'astro:content';
import { currentResult, medalFor } from '@/lib/content';
import { formatMonth, formatNumber } from '@/lib/utils';
import { useI18n } from '@/i18n';
import Medal from './Medal.astro';
import StatusBadge from './StatusBadge.astro';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'ctf'>;
  writeupCount?: number;
  /** Show all stages and categories */
  detailed?: boolean;
  link?: boolean;
}
const { entry, writeupCount = 0, detailed = false, link = true } = Astro.props;
const { name, year, date, team, handle, role, format, categories, stages } = entry.data;
const { stage, pending, medal } = currentResult(entry);
const { locale, t, href } = useI18n(Astro.url);
---

<article class="card-link relative flex h-full flex-col p-5 sm:p-6">
  <div class="flex items-start gap-4">
    <Medal medal={medal} rank={stage?.rank} />
    <div class="min-w-0 flex-1">
      <p class="font-mono text-[0.72rem] text-subtle">{date ? formatMonth(date, locale) : year}{format && ` · ${format}`}</p>
      <h3 class="mt-1 text-lg leading-snug font-semibold text-fg">
        {link ? <a href={href(`/ctf/${entry.id}`)} class="after:absolute after:inset-0 after:content-['']">{name}</a> : name}
      </h3>
      {
        stage?.rank && (
          <p class="mt-1 text-sm text-fg">
            <span class="font-medium">{t.ctf.place(stage.rank)}</span>
            {stages.length > 1 && <span class="text-muted"> — {stage.name}</span>}
            {stage.outOf && <span class="text-subtle"> / {t.ctf.teams(stage.outOf)}</span>}
            {stage.score !== undefined && <span class="font-mono text-xs text-subtle"> · {formatNumber(stage.score, locale)} {t.ctf.pts}</span>}
          </p>
        )
      }
    </div>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
    <div>
      <dt class="font-mono text-[0.7rem] text-subtle uppercase">{t.ctf.team}</dt>
      <dd class="mt-0.5 font-mono text-fg">{team}</dd>
    </div>
    {
      handle && (
        <div>
          <dt class="font-mono text-[0.7rem] text-subtle uppercase">{t.ctf.player}</dt>
          <dd class="mt-0.5 font-mono text-fg">{handle}</dd>
        </div>
      )
    }
    {
      role && (
        <div class="col-span-2">
          <dt class="font-mono text-[0.7rem] text-subtle uppercase">{t.ctf.role}</dt>
          <dd class="mt-0.5 text-muted">{role}</dd>
        </div>
      )
    }
  </dl>

  {
    (detailed || stages.length > 1) && (
      <ol class="mt-5 space-y-2 border-t border-line pt-4">
        {stages.map((s) => (
          <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <span class="flex items-center gap-2 text-muted">
              <Icon name={s.status === 'completed' ? 'check' : 'hourglass'} size={14} class={s.status === 'completed' ? 'text-accent' : 'text-subtle'} />
              {s.name}
            </span>
            {s.status === 'completed' && s.rank ? (
              <span class:list={['font-mono text-xs', medalFor(s.rank) === 'gold' ? 'text-gold' : medalFor(s.rank) === 'silver' ? 'text-silver' : medalFor(s.rank) === 'bronze' ? 'text-bronze' : 'text-fg']}>
                {t.ctf.place(s.rank)}
              </span>
            ) : (
              <StatusBadge status={s.status} />
            )}
          </li>
        ))}
      </ol>
    )
  }

  {
    detailed && categories.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {categories.map((c) => <span class="chip">{c}</span>)}
      </div>
    )
  }

  <div class="mt-auto flex items-center justify-between gap-3 pt-5 text-xs text-muted">
    {pending.length > 0 ? (
      <span class="text-warn">{pending.map((p) => `${p.name} — ${t.status[p.status]}`).join(' · ')}</span>
    ) : (
      <span>{stage ? t.ctf.finalRanking : t.ctf.participation}</span>
    )}
    {writeupCount > 0 && <span class="font-mono">{t.ctf.writeups(writeupCount)}</span>}
  </div>
</article>
