---
import { useI18n } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { t, href: to } = useI18n(Astro.url);
const { eyebrow, title, href, linkLabel = t.common.viewAll } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title mt-2">{title}</h2>
  </div>
  {
    href && (
      <a href={to(href)} class="group inline-flex shrink-0 items-center gap-1.5 text-sm text-muted hover:text-fg">
        {linkLabel}
        <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    )
  }
</div>
