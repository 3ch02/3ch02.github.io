---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WriteupCard from '@/components/WriteupCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { countTags, getProjects, getWriteups } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export async function getStaticPaths() {
  const [writeups, projects] = await Promise.all([getWriteups(), getProjects()]);
  return withLocales(countTags([...writeups, ...projects]).map(([tag]) => ({ params: { tag } })));
}

const { locale, t } = useI18n(Astro.url);
const tag = Astro.params.tag!;
const writeups = (await getWriteups()).filter((w) => w.data.tags.includes(tag));
const projects = (await getProjects(locale)).filter((p) => p.data.tags.includes(tag));
const total = writeups.length + projects.length;
---

<Layout title={`#${tag}`} description={t.tags.metaTagged(tag)} noindex={total < 2}>
  <PageHeader eyebrow={`tags/${tag}`} title={`#${tag}`} description={t.tags.tagged(total, tag)} />
  {
    writeups.length > 0 && (
      <section class="container-page">
        <p class="eyebrow mb-4">{t.nav.writeups}</p>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{writeups.map((w) => <WriteupCard entry={w} />)}</div>
      </section>
    )
  }
  {
    projects.length > 0 && (
      <section class="container-page mt-14">
        <p class="eyebrow mb-4">{t.nav.projects}</p>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{projects.map((p) => <ProjectCard entry={p} />)}</div>
      </section>
    )
  }
</Layout>
