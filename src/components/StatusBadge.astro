---
type Status = 'completed' | 'ongoing' | 'upcoming' | 'in-progress' | 'planned' | 'archived' | 'obtained';
interface Props {
  status: Status;
  label?: string;
}
const { status, label } = Astro.props;
const styles: Record<Status, { cls: string; text: string }> = {
  completed: { cls: 'text-accent border-accent/30 bg-accent/10', text: 'Completed' },
  obtained: { cls: 'text-accent border-accent/30 bg-accent/10', text: 'Obtained' },
  ongoing: { cls: 'text-warn border-warn/30 bg-warn/10', text: 'Ongoing' },
  'in-progress': { cls: 'text-warn border-warn/30 bg-warn/10', text: 'In progress' },
  upcoming: { cls: 'text-silver border-line-strong bg-surface-2', text: 'Upcoming' },
  planned: { cls: 'text-muted border-line-strong bg-surface-2', text: 'Planned' },
  archived: { cls: 'text-subtle border-line bg-surface', text: 'Archived' },
};
const s = styles[status];
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-[0.7rem]', s.cls]}>
  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
  {label ?? s.text}
</span>
