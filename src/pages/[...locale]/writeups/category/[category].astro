---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WriteupExplorer from '@/components/WriteupExplorer.astro';
import { WRITEUP_CATEGORIES } from '@/content.config';
import { categorySlug, getWriteups } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export function getStaticPaths() {
  return withLocales(WRITEUP_CATEGORIES.map((category) => ({ params: { category: categorySlug(category) }, props: { category } })));
}

const { category } = Astro.props;
const { t } = useI18n(Astro.url);
const all = await getWriteups();
const entries = all.filter((w) => w.data.category === category);
---

<Layout title={t.writeups.categoryTitle(category)} description={t.writeups.categoryDescription(category)}>
  <PageHeader eyebrow={`writeups/${categorySlug(category)}`} title={category} description={t.writeups.categoryDescription(category)} />
  <section class="container-page">
    <WriteupExplorer entries={entries} all={all} active={category} />
  </section>
</Layout>
