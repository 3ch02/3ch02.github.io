---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { CV, SOCIALS } from '@/config/site';
import { url } from '@/lib/utils';

---

<Layout title="Contact" description="How to get in touch with KERIM Loukouman (3ch0).">
  <PageHeader
    eyebrow="contact"
    title="Contact"
    description="Questions about a write-up, a project, a CTF team or an opportunity — reach out through any of the channels below."
  />

  <section class="container-page max-w-3xl">

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        SOCIALS.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel="me noopener"
              class="card-link group flex items-center gap-4 p-5"
            >
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-surface-2 text-accent">
                <Icon name={s.icon} size={20} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-medium text-fg">{s.label}</span>
                <span class="block truncate font-mono text-xs text-muted">{s.display ?? s.href.replace(/^(mailto:|https?:\/\/(www\.)?)/, '')}</span>
              </span>
              <Icon name="external" size={15} class="text-subtle group-hover:text-fg" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="card mt-10 p-6">
      <p class="eyebrow">CV</p>
      {
        CV.available ? (
          <a href={url(CV.href)} class="btn-primary mt-4" download>
            <Icon name="download" size={16} /> Download CV
          </a>
        ) : (
          <p class="mt-3 text-sm text-muted">My CV is available on request — send me a message through one of the channels above.</p>
        )
      }
    </div>
  </section>
</Layout>
