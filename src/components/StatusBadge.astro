---
import { useI18n } from '@/i18n';

type Status = 'completed' | 'ongoing' | 'upcoming' | 'in-progress' | 'planned' | 'archived' | 'obtained';
interface Props {
  status: Status;
  label?: string;
}
const { status, label } = Astro.props;
const { t } = useI18n(Astro.url);
const styles: Record<Status, { cls: string }> = {
  completed: { cls: 'text-accent border-accent/30 bg-accent/10' },
  obtained: { cls: 'text-accent border-accent/30 bg-accent/10' },
  ongoing: { cls: 'text-warn border-warn/30 bg-warn/10' },
  'in-progress': { cls: 'text-warn border-warn/30 bg-warn/10' },
  upcoming: { cls: 'text-silver border-line-strong bg-surface-2' },
  planned: { cls: 'text-muted border-line-strong bg-surface-2' },
  archived: { cls: 'text-subtle border-line bg-surface' },
};
const s = styles[status];
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-[0.7rem]', s.cls]}>
  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
  {label ?? t.status[status]}
</span>
