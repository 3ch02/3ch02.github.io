---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CompetitionCard from '@/components/CompetitionCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import WriteupCard from '@/components/WriteupCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import Icon from '@/components/Icon.astro';
import { getCompetitions, getProjects, getWriteups, writeupsFor } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export const getStaticPaths = () => withLocales();

const { locale, t, href } = useI18n(Astro.url);

const [competitions, projects, writeups] = await Promise.all([getCompetitions(locale), getProjects(locale), getWriteups()]);
const featuredProjects = projects.filter((p) => p.data.featured);
const otherProjects = projects.filter((p) => !p.data.featured).slice(0, 3);
const latestWriteups = writeups.slice(0, 6);

const approach = t.home.approach.map((a, i) => ({ step: `0${i + 1}`, ...a }));
---

<Layout>
  <Hero />

  <!-- CTF track record -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow={t.home.ctfEyebrow} title={t.home.ctfTitle} href="/ctf" linkLabel={t.home.ctfLink} />
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        competitions.slice(0, 4).map((c) => (
          <div class="reveal">
            <CompetitionCard entry={c} writeupCount={writeupsFor(c, writeups).length} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projects -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow={t.home.projectsEyebrow} title={t.home.projectsTitle} href="/projects" linkLabel={t.home.projectsLink} />
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {
        featuredProjects.map((p) => (
          <div class="reveal lg:col-span-3">
            <ProjectCard entry={p} highlight />
          </div>
        ))
      }
      {
        otherProjects.map((p) => (
          <div class="reveal">
            <ProjectCard entry={p} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Writeups -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow={t.home.writeupsEyebrow} title={t.home.writeupsTitle} href="/writeups" linkLabel={t.home.writeupsLink} />
    </div>
    {
      latestWriteups.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {latestWriteups.map((w) => (
            <div class="reveal">
              <WriteupCard entry={w} />
            </div>
          ))}
        </div>
      ) : (
        <div class="reveal">
          <EmptyState title={t.home.writeupsEmptyTitle} icon="file">{t.home.writeupsEmpty}</EmptyState>
        </div>
      )
    }
  </section>

  <!-- Approach + skills -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal">
      <SectionHeading eyebrow={t.home.approachEyebrow} title={t.home.approachTitle} />
    </div>
    <ol class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        approach.map((a) => (
          <li class="reveal bg-surface p-6">
            <span class="font-mono text-xs text-accent">{a.step}</span>
            <h3 class="mt-3 font-semibold text-fg">{a.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{a.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-16">
      <SectionHeading eyebrow={t.home.skillsEyebrow} title={t.home.skillsTitle} href="/about#skills" linkLabel={t.home.skillsLink} />
      <SkillGroups />
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-12 sm:py-16">
    <div class="reveal card relative overflow-hidden px-6 py-10 sm:px-10 sm:py-12">
      <div class="grid-backdrop pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow">{t.home.ctaEyebrow}</p>
          <h2 class="section-title mt-2">{t.home.ctaTitle}</h2>
          <p class="mt-3 text-muted">{t.home.ctaText}</p>
        </div>
        <a href={href('/contact')} class="btn-primary shrink-0">{t.home.ctaButton} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Layout>
