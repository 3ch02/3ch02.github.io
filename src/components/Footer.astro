---
import { NAV, SITE, SOCIALS } from '@/config/site';
import { useI18n } from '@/i18n';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const { t, href } = useI18n(Astro.url);
---

<footer class="mt-20 border-t border-line">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo class="text-lg" />
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
        {t.site.footer(SITE.name, SITE.school)}
      </p>
    </div>

    <div>
      <p class="eyebrow mb-3">{t.nav.navigate}</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {NAV.map((n) => <li><a class="text-muted hover:text-fg" href={href(n.href)}>{t.nav[n.key]}</a></li>)}
        <li><a class="text-muted hover:text-fg" href={href('/tags')}>{t.nav.tags}</a></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-3">{t.nav.elsewhere}</p>
      <ul class="space-y-2 text-sm">
        {
          SOCIALS.map((s) => (
            <li>
              <a class="inline-flex items-center gap-2 text-muted hover:text-fg" href={s.href} rel="me noopener" target="_blank">
                <Icon name={s.icon} size={16} />
                {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="inline-flex items-center gap-2 text-muted hover:text-fg" href={href('/contact')}>
            <Icon name="mail" size={16} /> {t.nav.contact}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-5 font-mono text-xs text-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name} — {SITE.handle}</p>
    </div>
  </div>
</footer>
