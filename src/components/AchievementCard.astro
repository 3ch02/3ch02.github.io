---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { bodyOf, currentResult, getCompetitions, type Medal as MedalT } from '@/lib/content';
import { useI18n } from '@/i18n';
import { formatMonth, isoDate } from '@/lib/utils';
import Medal from './Medal.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  entry: CollectionEntry<'achievements'>;
}
const { entry } = Astro.props;
const { title, year, date, headline, medal: ownMedal } = entry.data;
const { locale, t, href } = useI18n(Astro.url);

// Results come from the linked CTF entry when there is one (single source of truth).
const competition = (await getCompetitions(locale)).find((c) => c.id === entry.data.competition?.id);
const result = competition ? currentResult(competition) : undefined;

// Cover photo: the achievement's own image, falling back to the competition's.
// Shown directly on the card — no need to click through to see it.
const cover = entry.data.cover ?? competition?.data.cover;

const medal: MedalT = result?.medal ?? ownMedal;
const rank = result?.stage?.rank;
const line =
  result?.stage?.rank !== undefined
    ? `${t.ctf.place(result.stage.rank)}${competition!.data.stages.length > 1 ? ` — ${result.stage.name}` : ''}`
    : headline;

const { Content } = await render(await bodyOf(entry, locale));
---

<article class="card group relative flex flex-col overflow-hidden">
  {
    cover && (
      <div class="aspect-[21/9] overflow-hidden bg-surface-2">
        <Image
          src={cover}
          alt={`${title} — ${t.ctf.eventPhoto}`}
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 700px, 100vw"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    )
  }
  <div class="flex flex-col gap-5 p-5 sm:flex-row sm:p-6">
    <Medal medal={medal} rank={rank} />
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-lg font-semibold text-fg">
          {competition ? <a class="hover:text-accent" href={href(`/ctf/${competition.id}`)}>{title}</a> : title}
        </h3>
        {date ? <time class="font-mono text-xs text-subtle" datetime={isoDate(date)}>{formatMonth(date, locale)}</time> : <span class="font-mono text-xs text-subtle">{year}</span>}
      </div>
      {line && <p class="mt-1 text-[0.95rem] font-medium text-fg">{line}</p>}
      {
        competition && (
          <p class="mt-1 font-mono text-sm text-muted">
            {t.ctf.team} <span class="text-fg">{competition.data.team}</span>
            {competition.data.handle && <> · {t.ctf.player} <span class="text-fg">{competition.data.handle}</span></>}
          </p>
        )
      }
      {
        result && result.pending.length > 0 && (
          <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-muted">
            {result.pending.map((p) => (
              <>
                <span>{p.name}</span>
                <StatusBadge status={p.status} />
              </>
            ))}
          </div>
        )
      }
      <div class="mt-3 text-sm leading-relaxed text-muted [&_p+p]:mt-2">
        <Content />
      </div>
    </div>
  </div>
</article>
