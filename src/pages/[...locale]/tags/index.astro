---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Tag from '@/components/Tag.astro';
import EmptyState from '@/components/EmptyState.astro';
import { countTags, getProjects, getWriteups } from '@/lib/content';
import { useI18n, withLocales } from '@/i18n';

export const getStaticPaths = () => withLocales();

const { t } = useI18n(Astro.url);

const tags = countTags([...(await getWriteups()), ...(await getProjects())]);
---

<Layout title={t.tags.title} description={t.tags.metaDescription}>
  <PageHeader eyebrow="tags" title={t.tags.title} description={t.tags.description} />
  <section class="container-page">
    {
      tags.length ? (
        <div class="flex flex-wrap gap-2">{tags.map(([tag, n]) => <Tag tag={tag} count={n} />)}</div>
      ) : (
        <EmptyState title={t.tags.empty} icon="tag" />
      )
    }
  </section>
</Layout>
