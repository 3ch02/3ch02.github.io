---
import type { CollectionEntry } from 'astro:content';
import { WRITEUP_CATEGORIES } from '@/content.config';
import { categorySlug, getSources } from '@/lib/content';
import { useI18n } from '@/i18n';
import WriteupCard from './WriteupCard.astro';
import EmptyState from './EmptyState.astro';
import Icon from './Icon.astro';

interface Props {
  /** Entries displayed in the grid */
  entries: CollectionEntry<'writeups'>[];
  /** All entries — used for category counts */
  all: CollectionEntry<'writeups'>[];
  /** Active category */
  active?: string;
  /** Active source family (e.g. "picoCTF") */
  activeSource?: string;
}
const { entries, all, active, activeSource } = Astro.props;
const sources = getSources(all);
const { t, href } = useI18n(Astro.url);
const chip = (on: boolean, empty = false) => [
  'inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm whitespace-nowrap transition-colors',
  on ? 'border-accent/40 bg-accent/10 text-fg' : empty ? 'border-line/60 text-subtle hover:text-muted' : 'border-line text-muted hover:border-line-strong hover:text-fg',
];
const count = (c: string) => all.filter((w) => w.data.category === c).length;
---

<div data-explorer data-one={t.writeups.one} data-many={t.writeups.many} data-matching={t.writeups.matchingWord}>
  <div class="flex flex-col gap-4">
    <label class="relative block">
      <span class="sr-only">{t.writeups.search}</span>
      <Icon name="search" size={17} class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-subtle" />
      <input
        type="search"
        placeholder={t.writeups.searchPlaceholder}
        autocomplete="off"
        spellcheck="false"
        class="w-full rounded-lg border border-line bg-surface py-3 pr-4 pl-10 font-mono text-sm text-fg placeholder:text-subtle focus:border-accent-dim focus:outline-none"
        data-search-input
      />
    </label>

    <nav aria-label={t.writeups.categories} class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
      <ul class="flex gap-2 pb-1 sm:flex-wrap">
        <li>
          <a
            href={href('/writeups')}
            aria-current={!active && !activeSource ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm whitespace-nowrap transition-colors',
              !active && !activeSource ? 'border-accent/40 bg-accent/10 text-fg' : 'border-line text-muted hover:border-line-strong hover:text-fg',
            ]}
          >
            {t.writeups.all} <span class="font-mono text-xs text-subtle">{all.length}</span>
          </a>
        </li>
        {
          WRITEUP_CATEGORIES.map((c) => {
            const n = count(c);
            const isActive = active === c;
            return (
              <li>
                <a
                  href={href(`/writeups/category/${categorySlug(c)}`)}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm whitespace-nowrap transition-colors',
                    isActive
                      ? 'border-accent/40 bg-accent/10 text-fg'
                      : n > 0
                        ? 'border-line text-muted hover:border-line-strong hover:text-fg'
                        : 'border-line/60 text-subtle hover:text-muted',
                  ]}
                >
                  {c} <span class="font-mono text-xs text-subtle">{n}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    {
      sources.length > 0 && (
        <nav aria-label={t.writeups.sources} class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
          {(['competition', 'platform'] as const).map((kind) => {
            const list = sources.filter((x) => x.kind === kind);
            return list.length > 0 && (
              <div class="mb-2 flex items-center gap-2 pb-1 sm:flex-wrap">
                <span class="w-28 shrink-0 font-mono text-[0.7rem] text-subtle uppercase">{kind === 'competition' ? t.writeups.competitions : t.writeups.platforms}</span>
                {list.map((x) => (
                  <a href={href(`/writeups/source/${x.slug}`)} aria-current={activeSource === x.name ? 'page' : undefined} class:list={chip(activeSource === x.name)}>
                    {x.name} <span class="font-mono text-xs text-subtle">{x.count}</span>
                  </a>
                ))}
              </div>
            );
          })}
        </nav>
      )
    }
  </div>

  <p class="mt-6 mb-4 font-mono text-xs text-subtle" aria-live="polite" data-result-count>
    {t.writeups.count(entries.length)}
  </p>

  {
    entries.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-grid>
        {entries.map((w) => <WriteupCard entry={w} />)}
      </div>
    ) : (
      <EmptyState title={active ? t.writeups.emptyCategory(active) : t.writeups.empty} icon="file">
        {t.writeups.emptyText}
      </EmptyState>
    )
  }

  <div class="mt-8 flex justify-center" data-more hidden>
    <button type="button" class="btn-ghost">{t.writeups.showMore}</button>
  </div>

  <div class="hidden" data-no-results>
    <EmptyState title={t.writeups.noMatch} icon="search">{t.writeups.noMatchText}</EmptyState>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-explorer]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const cards = root ? [...root.querySelectorAll<HTMLElement>('[data-writeup]')] : [];
  const counter = root?.querySelector<HTMLElement>('[data-result-count]');
  const empty = root?.querySelector<HTMLElement>('[data-no-results]');

  const more = root?.querySelector<HTMLElement>('[data-more]');
  const PAGE = 24;

  if (input && cards.length) {
    let limit = PAGE;
    // Without a search, cards are shown one page at a time; a search always shows every match.
    const apply = () => {
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let matches = 0;
      for (const card of cards) {
        const hay = card.dataset.search ?? '';
        const match = terms.every((t) => hay.includes(t.replace(/^#/, '')));
        if (match) matches++;
        card.hidden = !match || (terms.length === 0 && matches > limit);
      }
      const { one, many, matching } = root!.dataset;
      if (counter) counter.textContent = `${matches} ${matches === 1 ? one : many}${terms.length ? ` ${matching} "${input.value.trim()}"` : ''}`;
      empty?.classList.toggle('hidden', matches > 0);
      if (more) more.hidden = terms.length > 0 || matches <= limit;
    };
    input.value = new URLSearchParams(location.search).get('q') ?? '';
    input.addEventListener('input', () => {
      apply();
      const params = new URLSearchParams(location.search);
      input.value ? params.set('q', input.value) : params.delete('q');
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
    });
    more?.querySelector('button')?.addEventListener('click', () => {
      limit += PAGE;
      apply();
    });
    apply();
  }
</script>
