---
import Layout from '@/layouts/Layout.astro';
import { url } from '@/lib/utils';
---

<Layout title="404 — Not found" noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center">
    <p class="font-mono text-sm text-muted"><span class="text-accent">$</span> cat {Astro.url.pathname}</p>
    <p class="mt-1 font-mono text-sm text-[#e0707a]">cat: No such file or directory</p>
    <h1 class="mt-6 text-3xl font-semibold text-fg sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a href={url('/')} class="btn-primary mt-8">cd ~</a>
  </section>
</Layout>
