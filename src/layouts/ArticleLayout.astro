---
import type { MarkdownHeading } from 'astro';
import 'virtual:shiki-theme.css';
import Layout from './Layout.astro';
import Icon from '@/components/Icon.astro';
import { url } from '@/lib/utils';

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  back: { href: string; label: string };
  publishedTime?: Date;
  tags?: string[];
  /** Language of the article body (the UI stays in English) */
  lang?: 'en' | 'fr';
}

const { title, description, headings = [], back, publishedTime, tags, lang = 'en' } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={title} description={description} type="article" publishedTime={publishedTime} tags={tags}>
  <div class="container-page pt-10 sm:pt-14">
    <a href={url(back.href)} class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-fg">
      <Icon name="arrow-left" size={14} class="transition-transform group-hover:-translate-x-0.5" />
      {back.label}
    </a>
  </div>

  <article class="container-page" lang={lang}>
    <header class="max-w-3xl pt-6 pb-8 sm:pb-10">
      <slot name="meta-top" />
      <h1 class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-fg sm:text-4xl">{title}</h1>
      {description && <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{description}</p>}
      <slot name="meta" />
    </header>

    <div class="grid gap-10 border-t border-line pt-8 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14 sm:pt-10">
      <div class="min-w-0">
        {
          toc.length > 2 && (
            <details class="card mb-8 px-4 py-3 lg:hidden">
              <summary class="cursor-pointer font-mono text-xs text-muted select-none">On this page</summary>
              <ul class="mt-3 space-y-2 text-sm">
                {toc.map((h) => (
                  <li class:list={[h.depth === 3 && 'pl-4']}>
                    <a class="text-muted hover:text-fg" href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        <div class="prose prose-invert prose-3ch0" data-article>
          <slot />
        </div>

        <slot name="after" />
      </div>

      {
        toc.length > 2 && (
          <aside class="hidden lg:block">
            <nav class="sticky top-24" aria-label="Table of contents">
              <p class="eyebrow mb-3">On this page</p>
              <ul class="space-y-2 border-l border-line text-sm" data-toc>
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-slug={h.slug}
                      class:list={[
                        '-ml-px block border-l border-transparent py-0.5 text-muted transition-colors hover:text-fg',
                        h.depth === 3 ? 'pl-7' : 'pl-4',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</Layout>

<script>
  const article = document.querySelector<HTMLElement>('[data-article]');

  if (article) {
    // Code blocks: language label + copy button
    article.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      const bar = document.createElement('div');
      bar.className = 'code-block__bar';
      const lang = document.createElement('span');
      lang.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-block__copy';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          btn.textContent = 'copied';
          btn.dataset.copied = '';
        } catch {
          btn.textContent = 'failed';
        }
        setTimeout(() => {
          btn.textContent = 'copy';
          delete btn.dataset.copied;
        }, 1600);
      });
      bar.append(lang, btn);
      pre.replaceWith(wrap);
      wrap.append(bar, pre);
    });

    // Tables: horizontal scroll container on small screens
    article.querySelectorAll('table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'table-wrap';
      table.replaceWith(wrap);
      wrap.append(table);
    });

    // External links open in a new tab
    article.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
      if (a.host !== location.host) {
        a.target = '_blank';
        a.rel = 'noopener';
      }
    });

    // Images: lazy by default
    article.querySelectorAll('img').forEach((img) => {
      if (!img.hasAttribute('loading')) img.loading = 'lazy';
      img.decoding = 'async';
    });
  }

  // Highlight the current section in the TOC
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc] a');
  if (tocLinks.length && 'IntersectionObserver' in window) {
    const map = new Map([...tocLinks].map((a) => [a.dataset.slug, a]));
    const setActive = (slug: string) =>
      tocLinks.forEach((a) => {
        const on = a.dataset.slug === slug;
        a.classList.toggle('!text-accent', on);
        a.classList.toggle('!border-accent', on);
      });
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    map.forEach((_, slug) => {
      const el = slug && document.getElementById(slug);
      if (el) io.observe(el);
    });
  }
</script>
